<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:orientation="vertical"
    android:padding="@dimen/launcher_screen_padding">

    <TextView
        style="@style/TextAppearance.Vr2xr.Launcher.Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/smb_browser_title" />

    <ScrollView
        android:id="@+id/smbConnectionPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/smbSavedProfilesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Vr2xr.Launcher.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_section_spacing"
                android:hint="@string/smb_host">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/smbHostInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Vr2xr.Launcher.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/smb_share">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/smbShareInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Vr2xr.Launcher.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/smb_domain_optional">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/smbDomainInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Vr2xr.Launcher.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/smb_username">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/smbUsernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Vr2xr.Launcher.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/smb_password"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/smbPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/smbRememberAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/smb_remember_account"
                android:textColor="@color/launcher_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/smbConnectButton"
                style="@style/Widget.Vr2xr.Launcher.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/smb_connect" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/smbStatusText"
        style="@style/TextAppearance.Vr2xr.Launcher.RuntimeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/smbCurrentFolderText"
        style="@style/TextAppearance.Vr2xr.Launcher.Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/smbNavigationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/smbBackButton"
            style="@style/Widget.Vr2xr.Launcher.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/smb_back" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/smbSortButton"
            style="@style/Widget.Vr2xr.Launcher.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/smb_sort_newest_first" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/smbEntriesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />
</LinearLayout>
